# Dedicated Alchemy apps (never commit real keys)
# Mainnet app: Ethereum / Base / X Layer / Zora / Robinhood / Polygon / Arbitrum / Optimism / Solana
# Testnet app: Ethereum Sepolia / Base Sepolia / Solana Devnet
ALCHEMY_MAINNET_API_KEY=
ALCHEMY_TESTNET_API_KEY=

# Optional per-chain RPC override. Alchemy remains primary when unset.
# Example names: RPC_OVERRIDE_BASE, RPC_OVERRIDE_XLAYER, RPC_OVERRIDE_ROBINHOOD, RPC_OVERRIDE_SOLANA

# Privy application credentials
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Privy resource owner. Keep admin authorization key out of agent runtime when possible.
PRIVY_ADMIN_OWNER_ID=
PRIVY_ADMIN_AUTHORIZATION_KEY=

# Restricted agent signer / key quorum
PRIVY_AGENT_SIGNER_ID=
PRIVY_AGENT_AUTHORIZATION_KEY=

# Created by `npm run privy:bootstrap`
PRIVY_EVM_WALLET_ID=
PRIVY_EVM_WALLET_ADDRESS=
PRIVY_EVM_LOCK_POLICY_ID=
PRIVY_SOLANA_WALLET_ID=
PRIVY_SOLANA_WALLET_ADDRESS=
PRIVY_SOLANA_AGENTSOUL_POLICY_ID=

# Agent Soul x402. Discover/verify payTo and network before enabling writes.
AGENTSOUL_PAYTO=
AGENTSOUL_X402_NETWORK=
AGENTSOUL_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
AGENT_NAME=OpenSesame
AGENT_BIO=Human-AI collaborative agent exploring agent-native digital art.
AGENT_ART_STYLE=generative systems

# Generic agentsmint / mint.bot integration
MINTBOT_API_KEY=

# Write gate. Keep false until an intended operation is being executed.
OPENSESAME_WRITE_ENABLED=false

# SHA-256 printed by preflight / submit preparation. Required for direct mint submission.
# The one-command GO paths derive and bind the same operation internally.
MINT_APPROVAL_SHA256=
